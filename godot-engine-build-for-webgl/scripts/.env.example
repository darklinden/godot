# Local toolchain paths — copy to .env and adjust for your machine.
#   cp .env.example .env
#
# .env is git-ignored; only .env.example is committed.

# Emscripten SDK activation script (required for WASM builds).
# Set to the full path of your emsdk_env.sh:
EMSDK_ENV="/opt/home/Github/emsdk/emsdk_env.sh"

# elan bin directory (optional, for Rust GDExtension builds).
# Appended to PATH before the build:
# ELAN_PATH="$HOME/.elan/bin"

SCRIPT_AES256_ENCRYPTION_KEY=